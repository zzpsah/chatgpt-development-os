{
  "protocol": "DEVOS-DISTRIBUTION-RELEASE-MANIFEST-v1",
  "product": "ChatGPT Development OS",
  "canonical_repository": "zzpsah/chatgpt-development-os",
  "version": "0.17.0",
  "channel": "stable",
  "minimum_python": "3.11",
  "entrypoint": "python tools/devos.py",
  "release_gate": "python tools/devos-release-check.py",
  "artifact_strategy": "git-archive-source-zip-with-sha256",
  "authority": "UNCHANGED",
  "authorization": "UNCHANGED",
  "execution": "NONE",
  "mutation": "NONE",
  "production_ready": false,
  "distribution_release_claim": "CI_REQUIRED",
  "publication": {
    "automatic_release": false,
    "automatic_tag": false,
    "automatic_deploy": false
  },
  "required_paths": [
    "README.md",
    "CHANGELOG.md",
    "VERSION",
    "AGENTS.md",
    ".ai/manifest.yaml",
    ".ai/CURRENT-STATE.md",
    ".ai/TASKS.md",
    "docs/RELEASE.md",
    ".github/SECURITY.md",
    "tools/devos.py",
    "tools/devos-doctor.py",
    "tools/devos-health.py",
    "tools/devos-release-check.py",
    ".github/workflows/verify-release-readiness.yml"
  ],
  "release_boundaries": [
    "Distribution release readiness is not production readiness.",
    "A green release gate does not authorize deployment or external mutation.",
    "Vendor runtime declarations are not verified integrations unless backed by merged conformance evidence.",
    "Release artifacts must be built from an exact Git commit and checksummed."
  ]
}
